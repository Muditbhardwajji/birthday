/* Loading bar */
.progress{
  width:220px;
  height:12px;
  background:#ddd;
  border-radius:20px;
  overflow:hidden;
  margin:15px auto;
}

.progress-bar{
  height:100%;
  width:0%;
  background:#4caf50;
  animation:loadbar 2.5s linear forwards;
}

@keyframes loadbar{
  from{width:0%;}
  to{width:100%;}
}


  body{ 
   margin:0;
  font-family:Arial,sans-serif;
  background:white;
  min-height:100vh;
  display:flex;
  justify-content:center;
  align-items:center;
}

.container{
  text-align:center;
}

.hidden{
  display:none;
}

 .card{
  background:#ffe6f0;
  padding:25px;
  border-radius:25px;
  width:90%;
  max-width:320px;
  text-align:center;
  box-shadow:0 10px 25px rgba(0,0,0,0.15);

